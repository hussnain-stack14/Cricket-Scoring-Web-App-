# Dependencies
node_modules/

# Environment files and secrets
.env
.env.*
!.env.example
!.env.*.example

# Build output
dist/
build/
.next/
out/
public/sw.js
public/icons/
coverage/
*.tsbuildinfo

# Tool caches
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local runtime files
*.pid
*.pid.lock

# Deployment metadata
.vercel/
.netlify/

# Editor-specific local settings
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.swp
*.swo
*~

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Local test reports
playwright-report/
test-results/

# Temporary files
tmp/
temp/
*.tmp

# Local uploads
# Keep this rule aligned with the backend storage directory.
backend/uploads/*
!backend/uploads/.gitkeep
.npm-cache/
.browsers/
